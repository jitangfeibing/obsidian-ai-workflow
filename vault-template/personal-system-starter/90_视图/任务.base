filters:
  and:
  - file.inFolder("personal-system-starter")
  - file.ext == "md"
  - '!("/" + file.path).contains("/91_模板/")'
  - '!("/" + file.path).lower().contains("/templates/")'
  - '!file.inFolder("personal-system-starter/99_迁移记录")'
  - note.is_example != true
  - note.archived != true
  - note.type == "task"
properties:
  note.分类:
    displayName: 分类
  note.archived:
    displayName: 归档
  file.name:
    displayName: 名称
  note.status:
    displayName: 状态
  note.topic:
    displayName: 主题
  note.due:
    displayName: 截止日期
  note.priority:
    displayName: 优先
  note.parent:
    displayName: 所属项目
  note.mastery:
    displayName: 掌握程度
  note.created:
    displayName: 记录日期
  note.next_review:
    displayName: 下次复习
  note.company:
    displayName: 公司
  note.interview_date:
    displayName: 面试日期
  note.source_url:
    displayName: 原页面
  note.type:
    displayName: 类型
  note.start:
    displayName: 开始
  note.end:
    displayName: 结束
  note.import_status:
    displayName: 迁移状态
views:
- type: table
  name: 待办
  filters:
    and:
    - '!["完成", "已完成", "Done", "done"].contains(note.status)'
  order:
  - file.name
  - 分类
  - status
  - due
  - priority
  - archived
  columnSize:
    note.status: 146
    note.priority: 214
- type: table
  name: 优先事项
  filters:
    and:
    - note.priority == true
    - '!["完成", "已完成", "Done", "done"].contains(note.status)'
  order:
  - file.name
  - 分类
  - status
  - due
  - archived
  sort:
  - property: archived
    direction: ASC
  columnSize:
    note.status: 250
    note.due: 378
    note.archived: 99
- type: table
  name: 延期任务
  filters:
    and:
    - note.due && note.due < today()
    - '!["完成", "已完成", "Done", "done"].contains(note.status)'
  order:
  - file.name
  - 分类
  - status
  - due
  - archived
  sort:
  - property: status
    direction: DESC
  - property: due
    direction: ASC
- type: table
  name: 暂停任务
  filters:
    and:
    - note.status == "暂停"
  order:
  - file.name
  - 分类
  - status
  - due
  - archived
- type: table
  name: 日程
  filters:
    and:
    - note.status == "日程"
  order:
  - file.name
  - 分类
  - status
  - due
  - archived
- type: kanban
  name: 任务看板
  groupBy:
    property: status
    direction: ASC
  order:
  - file.name
  - 分类
  - due
  - priority
- type: table
  name: 已完成
  filters:
    and:
    - '["完成", "已完成", "Done", "done"].contains(note.status)'
  order:
  - file.name
  - 分类
  - status
  - archived
